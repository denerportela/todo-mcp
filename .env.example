# URL pública do deploy (sem barra no final)
BASE_URL=https://seu-projeto.vercel.app

# App registrado no Microsoft Entra
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# "consumers" = só contas pessoais (outlook.com/hotmail). Use "common" se registrou para ambos.
MS_TENANT=consumers

# Supabase (service role: só no servidor, nunca no front)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Segredo longo e aleatório. Protege a URL do conector e a rota de login.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_SECRET=

# Fuso usado para "hoje" e para gravar datas
LOCAL_TZ=America/Sao_Paulo
GRAPH_TIMEZONE=E. South America Standard Time
